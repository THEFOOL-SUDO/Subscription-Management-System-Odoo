# ==============================================================================
# Brightloop Subscription Management System — Environment Configuration
# ==============================================================================

# Application Environment (development, staging, production)
ENVIRONMENT=development
PROJECT_NAME="Brightloop Subscription Management"
API_V1_STR="/api/v1"
DEBUG=true

# Security & Authentication
# Generate with: openssl rand -hex 32
SECRET_KEY=change-this-to-a-super-secret-random-key-in-production-brightloop-2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=60

# Database Configuration (PostgreSQL 16)
# Docker port mapped to 5435 to avoid conflicts with existing local PostgreSQL instances
POSTGRES_SERVER=localhost
POSTGRES_PORT=5435
POSTGRES_DB=brightloop_db
POSTGRES_USER=brightloop_user
POSTGRES_PASSWORD=brightloop_secret_password
DATABASE_URL=postgresql+asyncpg://brightloop_user:brightloop_secret_password@localhost:5435/brightloop_db
SYNC_DATABASE_URL=postgresql://brightloop_user:brightloop_secret_password@localhost:5435/brightloop_db

# Redis Configuration (Token Management & Rate Limiting)
# Docker port mapped to 6385 to avoid conflicts with existing local Redis instances
REDIS_HOST=localhost
REDIS_PORT=6385
REDIS_URL=redis://localhost:6385/0

# Mail Service (Mailpit for local testing)
# Web UI on port 8028, SMTP on port 1028
SMTP_HOST=localhost
SMTP_PORT=1028
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=noreply@brightloop.com
EMAILS_FROM_NAME="Brightloop Platform"

# Frontend Configuration
FRONTEND_URL=http://localhost:5173
VITE_API_BASE_URL=http://localhost:8000
